# ---------------------------------------------------------------------------
# Application server
# ---------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------------------------------------------------------------------
# Storage
#
# DATA_ROOT is the shared data root, mounted from the host:
#   - Local docker run:   /data  (mounted from ./accounting_pwa/server/data)
#   - Production compose: /data
#
# ATTACHMENTS_ROOT is the read-only subdirectory where Node writes uploaded
# images. Python reads images from here, never writes.
#
# APP_MAX_IMAGES_PER_INVOICE limits pages per single scan job.
# ---------------------------------------------------------------------------
DATA_ROOT=/data
ATTACHMENTS_ROOT=/data/attachments
APP_MAX_IMAGES_PER_INVOICE=20

# ---------------------------------------------------------------------------
# Anthropic / Claude
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_MAX_TOKENS=16384

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
OCR_LANG=german
OCR_USE_GPU=0